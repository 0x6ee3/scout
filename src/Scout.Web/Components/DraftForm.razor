@using System.ComponentModel.DataAnnotations
@inject NavigationManager Navigation
@inject ILogger<DraftForm> Logger

<section class="card form-card">
    <EditForm id="@FormName" EditContext="context" OnValidSubmit="SubmitAsync" FormName="@FormName">
        <DataAnnotationsValidator /><ValidationSummary />
        @if (error is not null) { <div class="message error" role="alert">@error</div> }
        <div class="form-actions"><button type="submit" disabled="@(saving || success)"><UiIcon Name="check" />@(saving ? "Saving…" : SaveLabel)</button>@if (DialogOwner is null) { <a href="@CancelUrl">Cancel</a> } else { <button type="button" class="secondary" disabled="@saving" @onclick="() => DialogOwner.RequestClose(context.IsModified())">Cancel</button> }</div>
        <fieldset class="editor-fields" disabled="@(saving || success)">
            <legend class="visually-hidden">@SaveLabel</legend>
            @ChildContent
        </fieldset>
    </EditForm>
</section>
<NavigationLock ConfirmExternalNavigation="@(saving || context.IsModified())" OnBeforeInternalNavigation="BeforeNavigation" />
<UiDialog Open="@(pending is not null)" Title="Leave without saving?" OnCancel="() => pending = null"><ChildContent><p>You have unsaved details.</p></ChildContent><Footer><button type="button" @onclick="() => pending = null">Keep editing</button><button type="button" class="secondary" @onclick="Leave">Leave without saving</button></Footer></UiDialog>
<UiDialog Open="@success" Title="Changes saved" OnCancel="Finish"><ChildContent><p>@SaveLabel completed successfully.</p></ChildContent><Footer><button type="button" @onclick="Finish">Done</button></Footer></UiDialog>
@code {
    [Parameter, EditorRequired] public object Model { get; set; } = default!;
    [Parameter, EditorRequired] public Func<Task<string>> Save { get; set; } = default!;
    [Parameter] public string CancelUrl { get; set; } = "/applications";
    [Parameter] public string SaveLabel { get; set; } = "Save";
    [Parameter] public string FormName { get; set; } = "Editor";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool AcknowledgeEmptyResult { get; set; }
    [CascadingParameter(Name = "DialogOwner")] public UiDialog? DialogOwner { get; set; }
    public bool IsSaving => saving;
    public string? Error => error;
    private EditContext context = default!;
    private object? previous;
    private bool saving, success, allowNavigation;
    private string? error, pending, destination;
    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(previous, Model)) { previous = Model; context = new(Model); error = pending = null; success=allowNavigation=false; DialogOwner?.RegisterClose(()=>{context.MarkAsUnmodified();allowNavigation=true;}); }
    }
    private async Task SubmitAsync()
    {
        if (saving) return;
        saving = true; error = null;
        DialogOwner?.SetBusy(true);
        try
        {
            destination = await Save();
            saving = false;
            if (!string.IsNullOrEmpty(destination) || AcknowledgeEmptyResult)
            {
                context.MarkAsUnmodified();
                if (DialogOwner is not null) DialogOwner.Complete($"{SaveLabel} completed successfully.", destination);
                else success = true;
            }
        }
        catch (Microsoft.EntityFrameworkCore.DbUpdateConcurrencyException) { error = "This content changed elsewhere. Your draft is retained. Copy it, reload and review the saved version before trying again."; }
        catch (ValidationException ex) { error = ex.Message; }
        catch (Scout.Web.Storage.DocumentImportException ex) { error = ex.Message; }
        catch (Exception ex) when (ex is Microsoft.EntityFrameworkCore.DbUpdateException or Microsoft.Data.Sqlite.SqliteException or IOException or UnauthorizedAccessException)
        {
            Logger.LogError(ex, "Could not save {FormName}.", FormName);
            error = "The change could not be saved. Your entered details are still here. Check storage access and try again.";
        }
        finally { saving = false; DialogOwner?.SetBusy(false); }
    }
    private async Task BeforeNavigation(LocationChangingContext change)
    {
        if(allowNavigation)return;
        if(DialogOwner is not null){change.PreventNavigation();if(!saving)await DialogOwner.RequestNavigationAsync(change.TargetLocation,context.IsModified());return;}
        if (saving || context.IsModified()) { change.PreventNavigation(); if (!saving) pending = change.TargetLocation; }
    }
    private void Leave() { var target = pending!; pending = null; context.MarkAsUnmodified(); Navigation.NavigateTo(target); }
    private void Finish() { success = false; if (!string.IsNullOrEmpty(destination)) Navigation.NavigateTo(destination); }
}

