@page "/next-actions/{Id:int}"
@using Scout.Web.Features.NextActions
@inject NextActionOperations Actions
<PageTitle>Next action · Scout</PageTitle><a class="back-link" href="@CatalogLinks.List("/next-actions",ListQuery)">← Next actions</a>
<LoadPanel Load="LoadAsync" LoadKey="@Id.ToString()">@if(action is null){<h1>Action not found</h1>}else{
<h1>@action.Title</h1><p>@action.Status · @(action.DueOn?.ToString("d")??"No due date")</p>
<PageActions><ActionLink Href="@CatalogLinks.Record($"/next-actions/{Id}/edit",ListQuery)" Label="Edit action" /><OperationButton Label="@(action.Status==NextActionStatus.Open?"Complete action":"Reopen action")" Save="@(()=>Actions.SetCompletedAsync(Id,action.Status==NextActionStatus.Open))" OnChanged="LoadAsync" /><ArchiveActions IsArchived="action.IsArchived" Subject="action" Explanation="Archiving does not mark this action completed." Save="@(a=>Actions.SetArchivedAsync(Id,a))" OnChanged="LoadAsync" /></PageActions>
<div class="entity-grid two-column"><section class="card details-card"><h2>Related work</h2><p><a href="@(action.ApplicationId.HasValue?$"/applications/{action.ApplicationId}":$"/positions/{action.PositionId}")">@(action.ApplicationId.HasValue?"Application":"Position")</a></p>@if(action.InterviewRoundId.HasValue){<p><a href="@($"/interviews/{action.InterviewRoundId}")">Related interview</a></p>}@if(action.TimelineEventId.HasValue){<p><a href="@($"/events/{action.TimelineEventId}")">Related event</a></p>}@if(action.CompletedAtUtc.HasValue){<p>Completed @action.CompletedAtUtc.Value.ToLocalTime().ToString("g")</p>}</section><section class="card details-card"><h2>Description</h2><p class="plain-text">@(action.Description??"No description added.")</p></section></div>
}</LoadPanel>
@code{[Parameter]public int Id{get;set;}[SupplyParameterFromQuery]public string? ListQuery{get;set;}private NextAction? action;private async Task LoadAsync()=>action=await Actions.GetAsync(Id);}


