@page "/interviews/{Id:int}"
@using Scout.Web.Features.Interviews
@using Scout.Web.Features.Contacts
@inject InterviewOperations Interviews
@inject ContactOperations Contacts
<PageTitle>Interview · Scout</PageTitle>
<LoadPanel Load="LoadAsync" LoadKey="@Id.ToString()">
@if(round is null){<h1>Interview not found</h1>}else{
<div class="page-heading"><div><p class="eyebrow">@round.Type · @round.Status @(round.IsArchived?"· Archived":"")</p><h1>@round.Title</h1><p>@round.Application.Position.Title</p></div></div>
<PageActions Label="Interview actions"><ActionLink Href="@($"/interviews/{Id}/preparation")" Label="Prepare interview" /><ActionLink Href="@($"/interviews/{Id}/workspace/setup")" Label="Review and open Workspace" Icon="workspace" /><ActionLink Href="@($"/interviews/{Id}/edit")" Label="Edit interview" /><ActionLink Href="@($"/next-actions/new?applicationId={round.ApplicationId}&interviewRoundId={Id}")" Label="Add next action" /><ArchiveActions IsArchived="round.IsArchived" Subject="interview" Explanation="Notes, participants, files and history are preserved." Save="@(a=>Interviews.SetArchivedAsync(Id,a))" OnChanged="LoadAsync" /></PageActions>
<div class="entity-grid"><aside class="entity-column"><section class="card details-card"><h2>Interview context</h2><dl><dt>Scheduled</dt><dd>@(round.ScheduledAtUtc?.ToLocalTime().ToString("g")??"Not recorded")</dd><dt>Actual completion</dt><dd>@(round.CompletedAtUtc?.ToLocalTime().ToString("g")??"Not recorded")</dd><dt>Time zone</dt><dd>@TimeZoneInfo.Local.DisplayName</dd><dt>Location / meeting</dt><dd>@if(Uri.TryCreate(round.LocationOrMeetingUrl,UriKind.Absolute,out var url)&&url.Scheme is "http" or "https"){<a href="@url" target="_blank" rel="noopener noreferrer">@round.LocationOrMeetingUrl</a>}else{<span>@(round.LocationOrMeetingUrl??"Not added")</span>}</dd></dl><h3>Participants</h3>@foreach(var c in participants){<p><a href="@($"/contacts/{c.Id}")">@c.Name</a> @(c.IsArchived?"(archived)":"")</p>}</section></aside>
<div class="entity-column"><section class="card details-card"><h2>Preparation notes</h2><MarkdownText Text='@(round.PreparationNotes??"Not added")' /></section><section class="card details-card"><h2>Interview notes</h2><MarkdownText Text='@(round.InterviewNotes??"Not added")' /></section></div>
<aside class="entity-column"><RecordingReview RoundId="Id" ReadOnly="round.IsArchived" /><TranscriptReview RoundId="Id" ReadOnly="round.IsArchived" /><Attachments Kind="Scout.Web.Features.Documents.DocumentOwnerKind.Interview" OwnerId="Id" ReturnUrl="@($"/interviews/{Id}")" /></aside></div>
}
</LoadPanel>
@code{[Parameter]public int Id{get;set;}private InterviewRound? round;private IReadOnlyList<ContactListItem> participants=[];private async Task LoadAsync(){round=await Interviews.GetAsync(Id);if(round is not null){var ids=await Interviews.SelectionAsync(Id);participants=(await Contacts.ListAsync(round.Application.Position.CompanyId,ArchiveFilter.All)).Where(c=>ids.Contains(c.Id)).ToList();}}}

