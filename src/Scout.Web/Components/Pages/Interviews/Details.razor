<p><a class="button" href="@($"/interviews/{Id}/workspace/setup")">Start Interview Workspace</a></p>
@page "/interviews/{Id:int}"
@using Scout.Web.Features.Interviews
@using Scout.Web.Features.Contacts
@inject InterviewOperations Interviews
@inject ContactOperations Contacts
<p><a class="button" href="@($"/interviews/{Id}/preparation")">Prepare interview</a></p>
<PageTitle>Interview · Scout</PageTitle>
<LoadPanel Load="LoadAsync" LoadKey="@Id.ToString()">@if(round is null){<h1>Interview not found</h1>}else{<a href="@($"/applications/{round.ApplicationId}")">← Application</a><h1>@round.Title</h1><p>@round.Type · @round.Status @(round.IsArchived?"· Archived":"")</p><a class="button" href="@($"/interviews/{Id}/edit")">Edit interview</a><section class="card details-card"><dl><dt>Scheduled</dt><dd>@(round.ScheduledAtUtc?.ToLocalTime().ToString("g")??"Not recorded")</dd><dt>Actual completion</dt><dd>@(round.CompletedAtUtc?.ToLocalTime().ToString("g")??"Not recorded")</dd><dt>Time zone</dt><dd>@TimeZoneInfo.Local.DisplayName</dd><dt>Location / meeting</dt><dd>@if(Uri.TryCreate(round.LocationOrMeetingUrl,UriKind.Absolute,out var url)&&url.Scheme is "http" or "https"){<a href="@url" target="_blank" rel="noopener noreferrer">@round.LocationOrMeetingUrl</a>}else{<span>@(round.LocationOrMeetingUrl??"Not added")</span>}</dd></dl><h2>Participants</h2>@foreach(var c in participants){<p><a href="@($"/contacts/{c.Id}")">@c.Name</a> @(c.IsArchived?"(archived)":"")</p>}<h2>Preparation notes</h2><p class="plain-text">@(round.PreparationNotes??"Not added")</p><h2>Interview notes</h2><p class="plain-text">@(round.InterviewNotes??"Not added")</p></section><p><a href="@($"/next-actions/new?applicationId={round.ApplicationId}&interviewRoundId={Id}")">Add next action</a></p><Attachments Kind="Scout.Web.Features.Documents.DocumentOwnerKind.Interview" OwnerId="Id" ReturnUrl="@($"/interviews/{Id}")" /><ArchiveActions IsArchived="round.IsArchived" Subject="interview" Explanation="Notes, participants, and history are preserved." Save="@(a=>Interviews.SetArchivedAsync(Id,a))" OnChanged="LoadAsync" />}</LoadPanel>
@code{[Parameter]public int Id{get;set;}private InterviewRound? round;private IReadOnlyList<ContactListItem> participants=[];private async Task LoadAsync(){round=await Interviews.GetAsync(Id);if(round is not null){var ids=await Interviews.SelectionAsync(Id);participants=(await Contacts.ListAsync(round.Application.Position.CompanyId,ArchiveFilter.All)).Where(c=>ids.Contains(c.Id)).ToList();}}}

