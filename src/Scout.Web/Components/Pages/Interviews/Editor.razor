@page "/applications/{ApplicationId:int}/interviews/new"
@page "/interviews/{Id:int}/edit"
@using Scout.Web.Features.Interviews
@using Scout.Web.Features.Contacts
@inject InterviewOperations Interviews
@inject ContactOperations Contacts
@inject Scout.Web.Features.Applications.ApplicationOperations Applications
<PageTitle>Interview · Scout</PageTitle><h1>@(Id.HasValue?"Edit interview":"Add interview")</h1>
<LoadPanel Load="LoadAsync" LoadKey="@($"{Id}/{ApplicationId}")">@if(missing){<p>Application or interview not found.</p>}else{<DraftForm Model="@model" Save="SaveAsync" CancelUrl="@Back" SaveLabel="Save interview" FormName="InterviewEditor">
<div class="field"><label for="title">Title (required)</label><InputText id="title" @bind-Value="model.Title" maxlength="200" /></div><div class="field"><label for="type">Interview type</label><InputSelect id="type" @bind-Value="model.Type">@foreach(var t in Enum.GetValues<InterviewType>()){<option value="@t">@t</option>}</InputSelect></div><div class="field"><label for="status">Interview status</label><InputSelect id="status" @bind-Value="model.Status">@foreach(var s in Enum.GetValues<InterviewStatus>()){<option value="@s">@s</option>}</InputSelect></div>
<LocalTimeField Id="schedule" Label="Scheduled time" @bind-Value="model.ScheduledLocal" @bind-OffsetMinutes="model.ScheduledOffset" /><LocalTimeField Id="completed" Label="Actual completion time (if known)" @bind-Value="model.CompletedLocal" @bind-OffsetMinutes="model.CompletedOffset" />
<div class="field"><label for="location">Location or meeting URL</label><InputText id="location" @bind-Value="model.LocationOrMeetingUrl" maxlength="2048" /></div><ContactPicker Contacts="contacts" Selected="model.ContactIds" Model="@model" Label="Participants (optional)" />
<div class="field"><label for="preparation">Preparation notes</label><InputTextArea id="preparation" @bind-Value="model.PreparationNotes" maxlength="100000" /><MarkdownPreview Text="@model.PreparationNotes" /></div><div class="field"><label for="notes">Interview notes</label><InputTextArea id="notes" @bind-Value="model.InterviewNotes" maxlength="100000" /><MarkdownPreview Text="@model.InterviewNotes" /></div><p>When enabled in an approved Workspace, live interview notes are visible there. Notes are saved when you select Save interview. Completion does not require participants, notes, recordings, or files.</p>
</DraftForm>}</LoadPanel>
@code{
    [Parameter]public int ApplicationId{get;set;}[Parameter]public int? Id{get;set;}private InterviewEditModel model=new();private bool missing;private IReadOnlyList<ContactListItem> contacts=[];
    private string Back=>Id.HasValue?$"/interviews/{Id}":$"/applications/{model.ApplicationId}";
    private async Task LoadAsync(){missing=false;model=new(){ApplicationId=ApplicationId};if(Id.HasValue){var r=await Interviews.GetAsync(Id.Value);if(r is null){missing=true;return;}model=new(){NotesRevision=r.NotesRevision,ApplicationId=r.ApplicationId,Title=r.Title,Type=r.Type,Status=r.Status,ScheduledLocal=r.ScheduledAtUtc?.ToLocalTime(),ScheduledOffset=r.ScheduledAtUtc.HasValue?(int)TimeZoneInfo.Local.GetUtcOffset(r.ScheduledAtUtc.Value).TotalMinutes:null,CompletedLocal=r.CompletedAtUtc?.ToLocalTime(),CompletedOffset=r.CompletedAtUtc.HasValue?(int)TimeZoneInfo.Local.GetUtcOffset(r.CompletedAtUtc.Value).TotalMinutes:null,LocationOrMeetingUrl=r.LocationOrMeetingUrl,PreparationNotes=r.PreparationNotes,InterviewNotes=r.InterviewNotes,ContactIds=await Interviews.SelectionAsync(r.Id)};}var a=await Applications.GetAsync(model.ApplicationId);missing=a is null;if(a is not null)contacts=await Contacts.ListAsync(a.Position.CompanyId,ArchiveFilter.All);}
    private async Task<string> SaveAsync()=>$"/interviews/{await Interviews.SaveAsync(Id,model)}";
}
