@page "/questions/{Id:int}"
@using Scout.Web.Features.Questions
@inject QuestionOperations Questions
@inject NavigationManager Navigation
<PageTitle>Employer question · Scout</PageTitle>
<LoadPanel Load="LoadAsync" LoadKey="@Id.ToString()">
@if(row is null) { <h1>Question not found</h1><p>It may have been deleted.</p><a href="@Back">Back to questions</a> } else {
<a href="@Back">← Employer questions</a><h1>@row.Text</h1><TagBadges Values="row.Tags.Select(x => x.Tag)" />
<PageActions><ActionLink Href="@CatalogLinks.Record($"/questions/{Id}/edit", ListQuery)" Label="Edit question" /><button type="button" class="secondary" @onclick="() => confirm = true"><UiIcon Name="delete" /> Delete question permanently</button><ArchiveActions IsArchived="row.IsArchived" Subject="question" Explanation="Existing interview copies are preserved." Save="@(a => Questions.SetArchivedAsync(Id, a))" OnChanged="LoadAsync" /></PageActions>
<div class="entity-grid"><section class="card details-card"><h2>Intent</h2><MarkdownText Text='@(row.Intent ?? "Not added")' /></section><section class="card details-card"><h2>Suggested follow-ups</h2><MarkdownText Text='@(row.FollowUpQuestions ?? "Not added")' /></section><section class="card details-card"><h2>Private library notes</h2><MarkdownText Text='@(row.Notes ?? "Not added")' /></section></div>
<UiDialog Open="@confirm" Title="Delete question permanently?" OnCancel="()=>confirm=false"><ChildContent><p>This permanently deletes this catalog question and its tags. @selectionCount interview copies will retain their wording, answers, and notes. No recycle bin.</p></ChildContent><Footer><button type="button" @onclick="()=>confirm=false">Cancel deletion</button><OperationButton Label="Confirm permanent deletion" Save="DeleteAsync" OnChanged="Deleted" /></Footer></UiDialog>
}
</LoadPanel>
@code {
    [Parameter] public int Id { get; set; }
    [SupplyParameterFromQuery] public string? ListQuery { get; set; }
    private EmployerQuestion? row; private bool confirm;
    private int selectionCount;
    private string Back => CatalogLinks.List("/questions", ListQuery);
    private async Task LoadAsync() { row = await Questions.GetAsync(Id); selectionCount = await Questions.SelectionCountAsync(Id); confirm = false; }
    private Task<bool> DeleteAsync() => Questions.DeleteAsync(Id);
    private void Deleted() => Navigation.NavigateTo(Back);
}
