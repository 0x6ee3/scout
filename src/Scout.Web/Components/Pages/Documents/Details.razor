@page "/documents/{Id:int}"
@using Scout.Web.Features.Documents
@using Scout.Web.Storage
@inject DocumentOperations Documents
<PageTitle>Document · Scout</PageTitle>
<a class="back-link" href="@CatalogLinks.List("/documents",ListQuery)">← Documents</a>
<LoadPanel Load="LoadAsync" LoadKey="@Id.ToString()">@if(document is null){<h1>Document not found</h1>}else{
<h1>@document.OriginalName</h1><p>@document.Category @(document.IsArchived?"· Archived":"")</p>
<PageActions><ActionLink Href="@CatalogLinks.Record($"/documents/{Id}/edit",ListQuery)" Label="Edit details" />@if(DocumentFileStore.CanPreview(document)){<ActionLink Href="@($"/documents/{Id}/view")" Label="Open preview" Icon="preview" Target="_blank" />}<ActionLink Href="@($"/documents/{Id}/download")" Label="Download original" Enhanced="false" /><ArchiveActions IsArchived="document.IsArchived" Subject="document" Explanation="The original file and existing history remain accessible." Save="@(a=>Documents.SetArchivedAsync(Id,a))" OnChanged="LoadAsync" /></PageActions>
<div class="entity-grid"><aside class="entity-column"><section class="card details-card"><h2>File information</h2><dl><dt>Size</dt><dd>@document.Size.ToString("N0") bytes</dd><dt>Imported</dt><dd>@document.ImportedAtUtc.ToLocalTime().ToString("g")</dd><dt>SHA-256</dt><dd class="plain-text">@document.Sha256</dd></dl></section></aside><section class="card details-card"><h2>Description</h2><p class="plain-text">@(document.Description ?? "No description added.")</p><p class="field-hint">Files are checked when opened. A missing or changed file is reported; restore the original from backup.</p></section><aside class="entity-column"><section class="card details-card"><h2>Linked records</h2>@if(relations.Count==0){<p>No general attachment links.</p>}@foreach(var r in relations){<p><a href="@r.Url">@r.Label</a></p>}</section></aside></div>
}</LoadPanel>
@code{[Parameter]public int Id{get;set;}[SupplyParameterFromQuery]public string? ListQuery{get;set;}private Document? document;private IReadOnlyList<DocumentRelation> relations=[];private async Task LoadAsync(){document=await Documents.GetAsync(Id);relations=await Documents.RelationsAsync(Id);}}

