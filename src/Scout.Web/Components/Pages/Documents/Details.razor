@page "/documents/{Id:int}"
@using Scout.Web.Features.Documents
@using Scout.Web.Storage
@inject DocumentOperations Documents
<PageTitle>Document · Scout</PageTitle><a href="@CatalogLinks.List("/documents",ListQuery)">← Documents</a><LoadPanel Load="LoadAsync" LoadKey="@Id.ToString()">@if(document is null){<h1>Document not found</h1>}else{<h1>@document.OriginalName</h1><p>@document.Category @(document.IsArchived?"· Archived":"")</p><a href="@CatalogLinks.Record($"/documents/{Id}/edit",ListQuery)">Edit details</a><section class="card details-card"><p class="plain-text">@document.Description</p><dl><dt>Size</dt><dd>@document.Size.ToString("N0") bytes</dd><dt>Imported</dt><dd>@document.ImportedAtUtc.ToLocalTime().ToString("g")</dd><dt>SHA-256</dt><dd class="plain-text">@document.Sha256</dd></dl><p>@if(DocumentFileStore.CanPreview(document)){<a href="@($"/documents/{Id}/view")" target="_blank" rel="noopener noreferrer">Open preview</a><span> · </span>}<a href="@($"/documents/{Id}/download")" data-enhance-nav="false">Download original</a></p><p>Files are checked when opened. A missing or changed file is reported; restore the original from backup.</p></section><section class="card details-card company-section"><h2>Linked records</h2>@if(relations.Count==0){<p>No general attachment links.</p>}@foreach(var r in relations){<p><a href="@r.Url">@r.Label</a></p>}</section><ArchiveActions IsArchived="document.IsArchived" Subject="document" Explanation="The file and existing history remain accessible." Save="@(a=>Documents.SetArchivedAsync(Id,a))" OnChanged="LoadAsync" />}</LoadPanel>
@code{[Parameter]public int Id{get;set;}[SupplyParameterFromQuery]public string? ListQuery{get;set;}private Document? document;private IReadOnlyList<DocumentRelation> relations=[];private async Task LoadAsync(){document=await Documents.GetAsync(Id);relations=await Documents.RelationsAsync(Id);}}

