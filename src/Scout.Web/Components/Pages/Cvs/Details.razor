@page "/cvs/{Id:int}"
@using Scout.Web.Features.Cvs
@inject CvOperations Cvs
<PageTitle>Prepared CV · Scout</PageTitle><a class="back-link" href="@CatalogLinks.List("/cvs",ListQuery)">← Prepared CVs</a>
<LoadPanel Load="LoadAsync" LoadKey="@Id.ToString()">@if(cv is null){<h1>CV not found</h1>}else{
<h1>@cv.DisplayName</h1><p>@cv.Language · @cv.TechnologyFocus</p>
<PageActions><ActionLink Href="@CatalogLinks.Record($"/cvs/{Id}/edit",ListQuery)" Label="Edit CV details" /><ActionLink Href="@($"/documents/{cv.DocumentId}/view")" Label="Open PDF" Icon="preview" Target="_blank" /><ActionLink Href="@($"/documents/{cv.DocumentId}/download")" Label="Download original" Enhanced="false" /><ArchiveActions IsArchived="cv.IsArchived" Subject="CV" Explanation="Existing submissions keep this exact version." Save="@(a=>Cvs.SetArchivedAsync(Id,a))" OnChanged="LoadAsync" /></PageActions>
<div class="entity-grid two-column"><section class="card details-card"><h2>Version context</h2><dl><dt>Language</dt><dd>@cv.Language</dd><dt>Focus</dt><dd>@cv.TechnologyFocus</dd><dt>State</dt><dd>@(cv.IsArchived?"Archived":"Active")</dd></dl></section><section class="card details-card"><h2>Preserved PDF</h2><p><a href="@($"/documents/{cv.DocumentId}")">@cv.Document.OriginalName</a></p><p>@cv.Document.Size.ToString("N0") bytes</p><p class="plain-text">SHA-256 @cv.Document.Sha256</p><p class="field-hint">Submitted-file history retains the exact version recorded at the time.</p></section></div>
}</LoadPanel>
@code{[Parameter]public int Id{get;set;}[SupplyParameterFromQuery]public string? ListQuery{get;set;}private PreparedCv? cv;private async Task LoadAsync()=>cv=await Cvs.GetAsync(Id);}

