@page "/cvs"
@using Scout.Web.Features.Cvs
@inject CvOperations Cvs
@inject NavigationManager Navigation
<PageTitle>Prepared CVs · Scout</PageTitle><h1>Prepared CVs</h1><p>Each entry preserves one imported PDF version.</p><ActionLink Href="@CatalogLinks.Record("/cvs/import",Query)" Label="Import CV version" /><form method="get" action="/cvs" class="filter-form"><label>Search label, language, or focus <input name="q" value="@Q" /></label><label>Archive <select name="archive" value="@Archive">@foreach(var a in Enum.GetValues<ArchiveFilter>()){<option value="@a" selected="@((CatalogLinks.ParseEnum<ArchiveFilter>(Archive)??ArchiveFilter.Active)==a)">@a</option>}</select></label><button>Apply filters</button><a href="/cvs">Clear</a></form>
<LoadPanel Load="LoadAsync" LoadKey="@Navigation.Uri">@if(rows.Count==0){<p>No prepared CVs match.</p>}@foreach(var c in rows){<article class="card details-card company-section"><h2><a href="@CatalogLinks.Record($"/cvs/{c.Id}",Query)">@c.DisplayName</a></h2><p>@c.Language · @c.TechnologyFocus @(c.IsArchived?"· Archived CV":"") @(c.DocumentIsArchived?"· Archived document":"")</p></article>}</LoadPanel>
@code{[SupplyParameterFromQuery]public string? Q{get;set;}[SupplyParameterFromQuery]public string? Archive{get;set;}private string Query=>new Uri(Navigation.Uri).Query;private IReadOnlyList<CvListItem> rows=[];private async Task LoadAsync()=>rows=await Cvs.ListAsync(CatalogLinks.ParseEnum<ArchiveFilter>(Archive)??ArchiveFilter.Active,Q);}


