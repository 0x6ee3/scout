@page "/applications/{Id:int}/timeline"
@using Scout.Web.Features.Timeline
@inject TimelineOperations Events
@inject NavigationManager Navigation
<PageTitle>Timeline · Scout</PageTitle><a href="@($"/applications/{Id}")">← Application</a><h1>Full timeline</h1><ActionLink Href="@($"/applications/{Id}/events/new")" Label="Add event" />
<form method="get" action="@($"/applications/{Id}/timeline")"><label>Archive <select name="archive" value="@Archive">@foreach (var v in Enum.GetValues<ArchiveFilter>()) { <option value="@v" selected="@((CatalogLinks.ParseEnum<ArchiveFilter>(Archive)??ArchiveFilter.Active)==v)">@v</option> }</select></label><button>Apply filter</button></form>
<LoadPanel Load="LoadAsync" LoadKey="@Navigation.Uri">@if (events.Count == 0) { <p>No events match.</p> }@foreach(var e in events) { <article class="card details-card company-section"><h2>@e.EventDate.ToString("d") · @(e.OccurredAtUtc?.ToLocalTime().ToString("t") ?? "Time not recorded") · @e.Kind</h2><p class="plain-text">@e.Description</p><a href="@($"/events/{e.Id}")">Event details, contacts, and documents</a>@if (e.IsSystem) { <p>Recorded system fact</p> } else { <a href="@($"/events/{e.Id}/edit")">Edit event</a><ArchiveActions IsArchived="e.IsArchived" Subject="event" Explanation="Only this event is archived." Save="@(a => Events.SetArchivedAsync(e.Id,a))" OnChanged="LoadAsync" /> }</article> }</LoadPanel>
@code { [Parameter] public int Id { get; set; } [SupplyParameterFromQuery] public string? Archive { get; set; } private IReadOnlyList<ApplicationTimelineEvent> events = []; private async Task LoadAsync() => events = await Events.ListAsync(Id, CatalogLinks.ParseEnum<ArchiveFilter>(Archive) ?? ArchiveFilter.Active); }





