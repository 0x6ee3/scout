@page "/submissions/{Id:int}"
@using Scout.Web.Features.Submissions
@using System.ComponentModel.DataAnnotations
@inject SubmissionOperations Submissions
<PageTitle>Submission history · Scout</PageTitle><LoadPanel Load="LoadAsync" LoadKey="@Id.ToString()">@if(submission is null){<h1>Submission not found</h1>}else{<a href="@($"/applications/{submission.ApplicationId}")">← Application</a><h1>Submission #@Id</h1><p>Already sent outside Scout on @submission.SubmittedOn.ToString("d"). Recorded @submission.RecordedAtUtc.ToLocalTime().ToString("g").</p>@if(submission.IsIncorrect){<div class="message error"><h2>Marked incorrect</h2><p class="plain-text">@submission.CorrectionReason</p><p>Original evidence is retained. <a href="@($"/applications/{submission.ApplicationId}/submissions/new")">Record a corrected submission</a>.</p></div>}<section class="card details-card company-section"><p class="plain-text">@submission.Notes</p><h2>Exact recorded files</h2>@if(files.Count==0){<p>No files were recorded for this historical submission.</p>}@foreach(var f in files){<article><h3>@f.Role · @f.LabelSnapshot</h3><p>@f.Document.OriginalName · @f.Document.Size.ToString("N0") bytes</p><p class="plain-text">SHA-256 @f.Document.Sha256</p><p><a href="@($"/documents/{f.DocumentId}/download")" data-enhance-nav="false">Download @f.LabelSnapshot</a> · <a href="@($"/documents/{f.DocumentId}")">Document details</a></p></article>}</section>@if(!submission.IsIncorrect){<PageActions><button type="button" class="secondary" @onclick="()=>showCorrection=true"><UiIcon Name="edit" /> Mark submission incorrect</button></PageActions>}<UiDialog Open="@showCorrection" Title="Mark submission incorrect" OnCancel="()=>showCorrection=false"><ChildContent><p>The original record stays intact. Add an explanation, then record a corrected submission separately if needed.</p><DraftForm Model="@correction" Save="CorrectAsync" CancelUrl="@($"/submissions/{Id}")" SaveLabel="Mark submission incorrect" FormName="SubmissionCorrection"><div class="field"><label for="reason">Correction reason (required)</label><InputTextArea id="reason" @bind-Value="correction.Reason" maxlength="100000" /></div></DraftForm></ChildContent></UiDialog>}</LoadPanel>
@code{[Parameter]public int Id{get;set;}private ApplicationSubmission? submission;private bool showCorrection;private IReadOnlyList<SubmissionFile> files=[];private sealed class Correction{[Required,StringLength(100000)]public string Reason{get;set;}="";}private Correction correction=new();private async Task LoadAsync(){submission=await Submissions.GetAsync(Id);files=await Submissions.FilesAsync(Id);}private async Task<string> CorrectAsync(){await Submissions.MarkIncorrectAsync(Id,correction.Reason);await LoadAsync();StateHasChanged();return $"/submissions/{Id}";}}


