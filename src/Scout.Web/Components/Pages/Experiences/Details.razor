@page "/experiences/{Id:int}"
@using Scout.Web.Features.Experiences
@inject ExperienceOperations Experiences
<PageTitle>STAR experience · Scout</PageTitle>
<LoadPanel Load="LoadAsync" LoadKey="@Id.ToString()">
@if(row is null) { <h1>Experience not found</h1> } else {
<a href="@CatalogLinks.List("/experiences", ListQuery)">← STAR experiences</a><h1>@row.Title</h1><TagBadges Values="row.Tags.Select(x => x.Tag)" />
<PageActions><ActionLink Href="@CatalogLinks.Record($"/experiences/{Id}/edit", ListQuery)" Label="Edit experience" /><ArchiveActions IsArchived="row.IsArchived" Subject="experience" Explanation="Existing interview selections and rehearsal notes are preserved." Save="@(a => Experiences.SetArchivedAsync(Id, a))" OnChanged="LoadAsync" /></PageActions>
<ExperienceStory Experience="row" Columns="true" />
}
</LoadPanel>
@code {
    [Parameter] public int Id { get; set; }
    [SupplyParameterFromQuery] public string? ListQuery { get; set; }
    private ProfessionalExperience? row;
    private async Task LoadAsync() => row = await Experiences.GetAsync(Id);
}
