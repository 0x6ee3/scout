@page "/experiences/new"
@page "/experiences/{Id:int}/edit"
@using Scout.Web.Features.Experiences
@inject ExperienceOperations Experiences
<PageTitle>STAR experience · Scout</PageTitle><h1>@(Id.HasValue ? "Edit STAR experience" : "Add STAR experience")</h1>
<p>Only the title is required. STAR is a helpful structure; fill in what you know. Library edits appear in all interviews that selected this experience; rehearsal notes stay separate.</p>
<LoadPanel Load="LoadAsync" LoadKey="@Id.ToString()">
@if(missing) { <p>Experience not found.</p> } else {
<DraftForm Model="@model" Save="SaveAsync" CancelUrl="@Back" SaveLabel="Save experience" FormName="ExperienceEditor">
<div class="field"><label for="title">Title (required)</label><InputText id="title" @bind-Value="model.Title" maxlength="200" /></div>
<div class="field"><label for="cue">Memory cue</label><InputTextArea id="cue" @bind-Value="model.MemoryCue" maxlength="1000" /><MarkdownPreview Text="@model.MemoryCue" /></div>
<div class="field"><label for="situation">Situation</label><InputTextArea id="situation" @bind-Value="model.Situation" maxlength="100000" /><MarkdownPreview Text="@model.Situation" /></div>
<div class="field"><label for="task">Task</label><InputTextArea id="task" @bind-Value="model.Task" maxlength="100000" /><MarkdownPreview Text="@model.Task" /></div>
<div class="field"><label for="action">Action</label><InputTextArea id="action" @bind-Value="model.Action" maxlength="100000" /><MarkdownPreview Text="@model.Action" /></div>
<div class="field"><label for="result">Result</label><InputTextArea id="result" @bind-Value="model.Result" maxlength="100000" /><MarkdownPreview Text="@model.Result" /></div>
<div class="field"><label for="reflection">Reflection</label><InputTextArea id="reflection" @bind-Value="model.Reflection" maxlength="100000" /><MarkdownPreview Text="@model.Reflection" /></div>
<div class="field"><label for="useful">Useful for / likely prompts</label><InputTextArea id="useful" @bind-Value="model.UsefulFor" maxlength="100000" /><MarkdownPreview Text="@model.UsefulFor" /></div>
<div class="field"><label for="notes">Private library notes</label><InputTextArea id="notes" @bind-Value="model.Notes" maxlength="100000" /><MarkdownPreview Text="@model.Notes" /></div>
<TagEditor @bind-Value="model.Tags" />
</DraftForm> }
</LoadPanel>
@code {
    [Parameter] public int? Id { get; set; }
    [SupplyParameterFromQuery] public string? ListQuery { get; set; }
    private ExperienceEditModel model = new(); private bool missing;
    private string Back => Id.HasValue ? CatalogLinks.Record($"/experiences/{Id}", ListQuery) : CatalogLinks.List("/experiences", ListQuery);
    private async Task LoadAsync() {
        missing = false; model = new();
        if(Id.HasValue) { var row = await Experiences.GetAsync(Id.Value); missing = row is null; if(row is not null) model = new() { Title = row.Title, MemoryCue = row.MemoryCue, Situation = row.Situation, Task = row.Task, Action = row.Action, Result = row.Result, Reflection = row.Reflection, UsefulFor = row.UsefulFor, Notes = row.Notes, Tags = row.Tags.Select(x => x.Tag).ToList() }; }
        StateHasChanged();
    }
    private async Task<string> SaveAsync() => CatalogLinks.Record($"/experiences/{await Experiences.SaveAsync(Id, model)}", ListQuery);
}
