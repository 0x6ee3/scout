@using Scout.Web.Features.Interviews
@using Scout.Web.Features.NextActions
@inject InterviewOperations Interviews
@inject NextActionOperations Actions
<section class="card details-card company-section"><div class="section-heading"><h2>Interview rounds</h2><ActionLink Href="@($"/applications/{ApplicationId}/interviews/new")" Label="Add interview" Compact="true" /></div>@if(rounds.Count==0){<p>No interviews yet.</p>}@foreach(var r in rounds){<article class="preparation-entry"><h3><a href="@($"/interviews/{r.Id}")">@r.Title</a></h3><p>@r.Type · @r.Status @(r.IsArchived?"· Archived":"")</p><div class="item-actions"><ActionLink Href="@($"/interviews/{r.Id}/preparation")" Label="Prepare interview" /><ActionLink Href="@($"/interviews/{r.Id}/workspace/setup")" Label="Review Workspace" Icon="workspace" /></div></article>}</section>
<section class="card details-card company-section"><div class="section-heading"><h2>Next actions</h2><ActionLink Href="@($"/next-actions/new?applicationId={ApplicationId}")" Label="Add next action" Compact="true" /></div><p><a href="@($"/next-actions?applicationId={ApplicationId}")">All actions and filters</a></p>@if(actions.Count==0){<p>No open actions.</p>}@foreach(var a in actions){<p><a href="@($"/next-actions/{a.Id}")">@a.Title</a> · @(a.DueOn?.ToString("d")??"No due date")</p>}</section>
@code{[Parameter]public int ApplicationId{get;set;}private IReadOnlyList<NextActionListItem> actions=[];private IReadOnlyList<InterviewListItem> rounds=[];protected override async Task OnParametersSetAsync(){actions=await Actions.ListAsync(applicationId:ApplicationId);rounds=await Interviews.ListAsync(ApplicationId,ArchiveFilter.All);}}
