@using Scout.Web.Features.Documents
@using System.ComponentModel.DataAnnotations
@inject DocumentOperations Documents
<section class="card details-card company-section"><div class="section-heading"><h2>Documents</h2><div class="item-actions"><button type="button" class="icon-action" aria-label="Attach existing document" @onclick="()=>showPicker=true"><UiIcon Name="link" /><span class="action-tooltip">Attach existing document</span></button><ActionLink Href="@($"/documents/import?ownerKind={Kind}&ownerId={OwnerId}")" Label="Import and attach file" Compact="true" /></div></div>@if(linked.Count==0){<p class="compact-empty">No attachments yet.</p>}@foreach(var d in linked){<div class="attachment item-row"><div><a href="@($"/documents/{d.Id}")">@d.OriginalName</a> @(d.IsArchived?"(archived)":"")</div><div class="item-actions"><ActionLink Href="@($"/documents/{d.Id}/download")" Label="@($"Download {d.OriginalName}")" Compact="true" Enhanced="false" /><OperationButton Label="@($"Remove link to {d.OriginalName}")" Compact="true" Confirmation="Remove only this association? The original file and every other association are preserved." Save="@(()=>Documents.UnlinkAsync(Owner,d.Id))" OnChanged="LoadAsync" /></div></div>}</section>
<UiDialog Open="@showPicker" Title="Attach existing document" OnCancel="ClosePicker"><ChildContent><DraftForm Model="@draft" Save="LinkAsync" CancelUrl="@ReturnUrl" SaveLabel="Attach existing document" FormName="@PickerId"><div class="field"><label for="@PickerId">Existing active document</label><InputSelect id="@PickerId" @bind-Value="draft.DocumentId"><option value="0">Choose a document</option>@foreach(var d in options){<option value="@d.Id">@d.OriginalName · #@d.Id</option>}</InputSelect></div></DraftForm><p>Removing a link preserves the file and every other association.</p></ChildContent></UiDialog>
@code{
    [Parameter]public DocumentOwnerKind Kind{get;set;}[Parameter]public int OwnerId{get;set;}[Parameter]public string ReturnUrl{get;set;}="/documents";private DocumentOwner Owner=>new(Kind,OwnerId);private string PickerId=>$"attachment-{Kind}-{OwnerId}";
    private sealed class Selection{[Range(1,int.MaxValue)]public int DocumentId{get;set;}}private Selection draft=new();private IReadOnlyList<DocumentListItem> linked=[],options=[];
    private DocumentOwner? loadedOwner;
    private bool showPicker;
    protected override async Task OnParametersSetAsync(){if(loadedOwner==Owner)return;await LoadAsync();loadedOwner=Owner;}private async Task LoadAsync(){linked=await Documents.LinkedAsync(Owner);options=(await Documents.ListAsync()).Where(d=>!linked.Any(l=>l.Id==d.Id)).ToList();draft=new();}
    private async Task ClosePicker(){showPicker=false;await LoadAsync();}
    private async Task<string> LinkAsync(){await Documents.LinkAsync(Owner,draft.DocumentId);await LoadAsync();StateHasChanged();return ReturnUrl;}
}


